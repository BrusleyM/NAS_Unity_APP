/* Dealership selection - shown after login, before car selection. The
   customer picks where they're buying from, so the lead they generate lands
   with that dealership. Same palette as CarSelectionScreen.uss. */

.dealership-root {
    flex-grow: 1;
    background-color: transparent;
    flex-direction: column;
    padding: 6% 5% 24px 5%;
}

.dealership-header {
    align-items: center;
    margin-bottom: 6%;
}

.dealership-title {
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-bottom: 2%;
    color: rgb(192, 192, 192);
    -unity-font-style: bold;
}

.dealership-subtitle {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(192, 192, 192, 0.6);
}

.dealership-list {
    flex-grow: 1;
}

.dealership-card {
    flex-direction: row;
    align-items: center;
    margin: 0 0 12px 0;
    padding: 0 16px 0 0;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.2);
    border-radius: 12px;
    overflow: hidden;
}

.dealership-card:hover {
    background-color: rgba(0, 212, 255, 0.12);
    border-color: rgba(0, 212, 255, 0.5);
}

/* The dealership picked last time on this device - a hint, not a selection. */
.dealership-card--last {
    border-color: rgba(0, 212, 255, 0.6);
}

.dealership-card-accent {
    width: 4px;
    align-self: stretch;
    margin-right: 14px;
    background-color: rgb(0, 212, 255);
}

.dealership-card-body {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 16px 0;
}

.dealership-card-name {
    font-size: 16px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.dealership-card-detail {
    margin-top: 4px;
    font-size: 12px;
    color: rgba(192, 192, 192, 0.65);
    -unity-text-align: middle-left;
    white-space: normal;
}

.dealership-card-badge {
    margin-left: 8px;
    padding: 2px 8px;
    font-size: 10px;
    color: rgb(0, 212, 255);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.5);
    border-radius: 8px;
}

.dealership-status {
    align-items: center;
    padding: 24px 0;
}

.dealership-status-label {
    font-size: 14px;
    color: rgba(192, 192, 192, 0.7);
    -unity-text-align: middle-center;
    white-space: normal;
}

.dealership-retry-button {
    margin-top: 16px;
    padding: 12px 32px;
    background-color: rgba(0, 212, 255, 0.8);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.5);
    border-radius: 12px;
    color: white;
    font-size: 14px;
}
