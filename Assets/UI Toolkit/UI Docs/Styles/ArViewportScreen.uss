.ar-viewport-root {
    flex-grow: 1;
    position: relative;
    height: 100%;
    background-color: transparent;
}

.top-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 16px 24px 16px;
    background-color: rgba(18, 18, 18, 0.55);
}

.back-button {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.3);
    border-radius: 8px;
    padding: 6px 12px;
    margin: 0;
}

.back-button:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

.back-chevron {
    color: rgb(192, 192, 192);
    font-size: 14px;
    margin-right: 2px;
}

.back-text {
    color: rgb(192, 192, 192);
    font-size: 12px;
}

.car-name-label {
    color: rgb(192, 192, 192);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.confirm-button {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(0, 212, 255, 0.2);
    border-width: 2px;
    border-color: rgba(0, 212, 255, 0.7);
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
}

.confirm-button:hover {
    background-color: rgba(0, 212, 255, 0.35);
}

.confirm-icon {
    color: rgb(0, 212, 255);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.gesture-hints {
    position: absolute;
    left: 16px;
    bottom: 40px;
}

.gesture-hint-label {
    color: rgba(192, 192, 192, 0.6);
    font-size: 12px;
}

.rotation-slider-row {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 92px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 18, 18, 0.55);
    border-radius: 20px;
    padding: 6px 16px;
}

.rotation-slider-label {
    color: rgba(192, 192, 192, 0.8);
    font-size: 12px;
    margin-right: 10px;
}

.rotation-slider {
    flex-grow: 1;
    margin: 0;
}

.vertical-offset-slider-column {
    position: absolute;
    right: 16px;
    top: 120px;
    bottom: 160px;
    width: 44px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(18, 18, 18, 0.55);
    border-radius: 20px;
    padding: 12px 0;
}

.vertical-offset-slider {
    flex-grow: 1;
    margin: 8px 0 0 0;
}

.reset-position-button {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.3);
    color: rgb(192, 192, 192);
    font-size: 16px;
    -unity-text-align: middle-center;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.reset-position-button:hover {
    background-color: rgba(255, 255, 255, 0.18);
    color: rgb(0, 212, 255);
    border-color: rgba(0, 212, 255, 0.6);
}

.settings-button-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.test-drive-button {
    height: 56px;
    margin: 0 0 0 12px;
    padding: 0 22px;
    border-radius: 28px;
    background-color: rgba(0, 212, 255, 0.18);
    border-width: 1.5px;
    border-color: rgba(0, 212, 255, 0.7);
    color: rgb(0, 212, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.test-drive-button:hover {
    background-color: rgba(0, 212, 255, 0.28);
}

.test-drive-button--done {
    background-color: rgba(18, 18, 18, 0.85);
    border-color: rgba(192, 192, 192, 0.45);
    color: rgb(192, 192, 192);
}

.settings-button {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgba(18, 18, 18, 0.85);
    border-width: 1.5px;
    border-color: rgba(0, 212, 255, 0.45);
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
}

.settings-button:hover {
    background-color: rgba(18, 18, 18, 0.95);
    border-color: rgba(0, 212, 255, 0.7);
}

.settings-icon {
    width: 24px;
    height: 24px;
    background-image: url("project://database/Assets/Textures/icons/gear.svg");
    -unity-background-image-tint-color: rgb(0, 212, 255);
    -unity-background-scale-mode: scale-to-fit;
}

.sheet-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

.customize-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(14, 14, 14, 0.97);
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: rgba(192, 192, 192, 0.15);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding-bottom: 24px;
}

.sheet-drag-handle {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(192, 192, 192, 0.3);
    align-self: center;
    margin-top: 12px;
    margin-bottom: 8px;
}

.sheet-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 24px 16px 24px;
}

.sheet-title {
    color: rgb(192, 192, 192);
    font-size: 14px;
}

.sheet-close-button {
    background-color: transparent;
    border-width: 0;
    color: rgba(192, 192, 192, 0.6);
    font-size: 16px;
    padding: 4px;
    margin: 0;
}

.sheet-placeholder-text {
    color: rgba(192, 192, 192, 0.6);
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 0 24px 8px 24px;
}

.category-grid {
    flex-direction: row;
    justify-content: space-between;
    padding: 0 24px 16px 24px;
}

.category-button {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
    padding: 12px 4px;
    border-radius: 12px;
    border-width: 1px;
    border-color: transparent;
    background-color: rgba(255, 255, 255, 0.05);
}

.category-button:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.category-button--active {
    background-color: rgba(0, 212, 255, 0.15);
    border-color: rgba(0, 212, 255, 0.7);
}

.category-icon {
    color: rgb(192, 192, 192);
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.category-button--active .category-icon {
    color: rgb(0, 212, 255);
}

/* Image-based icon variant for categories with a real SVG asset (currently
   just Paint) - the rest still use .category-icon's Unicode-glyph Label
   until they get their own icons. Same sizing/margin convention as
   .category-icon, tinted instead of colored since this is a background-image
   VisualElement, not a Label. */
.category-icon-image {
    width: 22px;
    height: 22px;
    margin-bottom: 6px;
    background-image: url("project://database/Assets/Textures/icons/paint-brush.svg");
    -unity-background-image-tint-color: rgb(192, 192, 192);
    -unity-background-scale-mode: scale-to-fit;
}

.category-button--active .category-icon-image {
    -unity-background-image-tint-color: rgb(0, 212, 255);
}

.category-label {
    color: rgba(192, 192, 192, 0.8);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.swatch-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 4px 24px 16px 24px;
}

.color-swatch {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.25);
    margin: 0 8px;
    padding: 0;
}

.color-swatch--selected {
    border-width: 2.5px;
    border-color: rgb(0, 212, 255);
}
