.login-card {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.3);
    padding: 24px 20px;
    width: 80%;
    min-height: 200px;
    height: auto;
    flex-direction: column;
}

.card-title {
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    color: rgb(192, 192, 192);
    -unity-font-style: bold;
}

.input-group {
    margin-bottom: 12px;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    justify-content: flex-start;
    align-content: flex-start;
    width: 100%;
    height: auto;
}

.field-label-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end; /* Align icon to bottom of label row */
    width: 100%;
    margin-bottom: 4px;
}

.field-label {
    font-size: 12px;
    color: rgb(192, 192, 192);
    margin-bottom: 0;
    align-self: flex-start;
}

.input-field {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    width: 100%;
}

.input-field .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.3);
    border-radius: 12px;
    padding: 3% 4%;
    color: rgb(192, 192, 192);
    font-size: 14px;
    transition-duration: 0.2s;
    height: 42px; /* Fixed height to prevent shrinking */
}

.input-field .unity-text-field__input:focus {
    border-color: rgb(0, 212, 255);
    background-color: rgba(255, 255, 255, 0.15);
}

/* Invalid field state — applied by the controller after a failed submit,
   removed as soon as validation passes again. */
.input-field--error .unity-text-field__input {
    background-color: rgba(255, 60, 60, 0.06);
    border-color: rgba(255, 60, 60, 0.8);
}

/* Per-field error message, shown under the field it applies to. */
.field-error {
    font-size: 11px;
    color: rgb(255, 85, 85);
    margin-top: 1%;
    align-self: flex-start;
    white-space: normal;
}

/* General/non-field-specific error (from the backend: wrong credentials,
   network error, etc.) shown near the submit button. */
.form-error {
    font-size: 12px;
    color: rgb(255, 85, 85);
    -unity-text-align: middle-center;
    margin-top: 2%;
    white-space: normal;
}

/* Password field + show/hide toggle sit in a row so the toggle stays
   inline without needing absolute-position math. */
.password-input-wrapper {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.password-input-wrapper .input-field {
    flex-grow: 1;
}

.password-toggle {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-left: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url('project://database/Assets/Textures/Icons/eye-open.svg');
    -unity-background-image-tint-color: rgba(192, 192, 192, 0.6);
}

.password-toggle--hidden {
    background-image: url('project://database/Assets/Textures/Icons/eye-closed.svg');
}

.password-toggle:hover {
    color: rgb(0, 212, 255);
}

.gradient-button {
    background-color: rgba(0, 212, 255, 0.8);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.5);
    border-radius: 12px;
    padding: 3% 4%;
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 0;
    transition-duration: 0.2s;
    /* Now holds a Label + spinner VisualElement as children (LoginCardController
       swaps which is visible) instead of relying on the text attribute -
       -unity-text-align above only positions Unity's own internal text
       rendering, not child element layout, so centering needs to be explicit
       here once real children are involved. */
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.gradient-button-label {
    color: white;
    font-size: 14px;
}

/* Spinning ring - same technique/speed as LoadingOverlayController's
   .loading-spinner (rotated in code, USS alone can't loop an indefinite
   rotation), sized down and in white instead of the accent blue since it
   sits on this button's own solid blue fill, not a dark background. */
.button-spinner {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.3);
    border-right-color: rgba(255, 255, 255, 0.3);
    border-bottom-color: rgba(255, 255, 255, 0.3);
    border-top-color: rgb(255, 255, 255);
}

.gradient-button:hover {
    background-color: rgba(0, 150, 200, 0.9);
}

.rich-text-link {
    font-size: 12px;
    color: rgba(192, 192, 192, 0.6);
    -unity-text-align: middle-center;
    margin-bottom: 0;
    margin-top: 12px;
    white-space: normal;
}

.rich-text-link .link {
    color: rgb(0, 212, 255);
}

.rich-text-link .link:hover {
    color: rgba(0, 212, 255, 0.8);
}

.last-input-group {
    margin-bottom: 14%;
}

/* "I accept the terms and privacy notice" row on the register card. */
.terms-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
}

.terms-label {
    margin-top: 0;
    margin-left: 6px;
    flex-shrink: 1;
    -unity-text-align: middle-left;
}
