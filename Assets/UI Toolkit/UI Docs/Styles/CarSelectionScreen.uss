.car-selection-root {
    flex-grow: 1;
    background-color: transparent;
    flex-direction: column;
    padding: 6% 5% 0 5%; /* Bottom moved to .start-button's own
        margin-bottom (see below) - percentage padding here resolves
        against this root's WIDTH, not height, so it was never a reliable
        way to control vertical space from the screen edge, and this used
        a different percentage (8%) than EstimatorScreen's equivalent root
        (4%), so the two screens' button spacing was never actually
        consistent despite looking similar. Standardized project-wide in
        .start-button/.gradient-button instead, with a fixed px value
        shared by both. */
}

.header {
    align-items: center;
    margin-bottom: 8%;
}

.title {
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-bottom: 2%;
    color: rgb(192, 192, 192);
    -unity-font-style: bold;
}

.subtitle {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(192, 192, 192, 0.6);
}

.tools-container {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8%;
}

.dropdown-container,
.search-container {
    width: 48%;
}

.dropdown-button {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.2);
    border-radius: 12px;
    padding: 3% 4%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.dropdown-text {
    font-size: 14px;
    color: rgb(192, 192, 192);
}

.dropdown-arrow {
    width: 16px;
    height: 16px;
    background-color: rgba(192, 192, 192, 0.5);
}

.dropdown-menu {
    position: absolute;
    background-color: rgba(18, 18, 18, 0.95);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.3);
    border-radius: 12px;
}

.dropdown-item {
    background-color: transparent;
    padding: 3% 4%;
    font-size: 14px;
    color: rgb(192, 192, 192);
    border-bottom-width: 1px;
    border-bottom-color: rgba(192, 192, 192, 0.1);
}

.dropdown-item:hover {
    background-color: rgba(0, 212, 255, 0.05);
}

.dropdown-item.selected {
    color: rgb(0, 212, 255);
    background-color: rgba(0, 212, 255, 0.1);
}

.dropdown-item.last-dropdown-item {
    border-bottom-width: 0;
}

.search-container {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.2);
    border-radius: 12px;
    padding: 3% 4%;
    flex-direction: row;
    align-items: center;
}

.search-icon {
    width: 16px;
    height: 16px;
    background-color: rgba(192, 192, 192, 0.5);
    margin-right: 2%;
}

.search-field {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
}

.search-field .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: rgb(192, 192, 192);
    font-size: 14px;
    padding: 0;
}

.cars-scroll-view {
    width: 85%;
    align-self: center;
    flex-grow: 1;
    margin-bottom: 8%;
    overflow: hidden;
}

.cars-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 100%;
    flex-grow: 1;
}

.car-card {
    width: 95%;
    height: 95%;
    flex-shrink: 0;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    flex-direction: column;
    align-items: center;
}

.car-image {
    width: 100%;
    height: 80%;
    background-color: transparent;
    margin-bottom: 4%;
}

.car-name {
    font-size: 16px;
    color: rgb(192, 192, 192);
    margin-bottom: 2%;
    -unity-text-align: middle-center;
    white-space: normal;
}

.car-category {
    font-size: 12px;
    color: rgba(192, 192, 192, 0.6);
    -unity-text-align: middle-center;
    white-space: normal;
}

.car-card--selected .car-name {
    color: rgb(0, 212, 255);
}

.car-card--selected .car-category {
    color: rgba(0, 212, 255, 0.7);
}

.car-card--hidden {
    visibility: hidden;
}

.empty-state {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgba(192, 192, 192, 0.6);
    margin-bottom: 8%;
}

.start-button {
    background-color: rgba(0, 212, 255, 0.8);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.5);
    border-radius: 12px;
    padding: 4%;
    color: white;
    font-size: 16px;
    -unity-text-align: middle-center;
    margin: 0 0 24px 0; /* Standardized project-wide bottom-of-screen
        button spacing - same 24px on EstimatorScreen's .gradient-button.
        See .car-selection-root's comment above for why this moved off
        the root's padding-bottom. */
    transition-property: background-color;
    transition-duration: 0.2s;
}

.start-button:hover {
    background-color: rgba(0, 150, 200, 0.9);
}

.unity-scroller {
    display: none;
}


/* Shows the chosen dealership under the title; tapping it goes back to the
   dealership list. */
.change-dealership-button {
    flex-direction: row;
    align-items: center;
    margin: 12px 0 0 0;
    padding: 6px 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.2);
    border-radius: 16px;
}

.change-dealership-name {
    font-size: 12px;
    color: rgb(192, 192, 192);
}

.change-dealership-action {
    margin-left: 8px;
    font-size: 12px;
    color: rgb(0, 212, 255);
}
