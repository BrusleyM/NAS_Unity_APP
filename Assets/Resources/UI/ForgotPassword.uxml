<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/LoginScreen.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/ProfileScreens.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/AccountCards.uss"/>
    <ui:VisualElement name="forgot-password-card" class="login-card" style="flex-wrap: nowrap; justify-content: center;">
        <ui:Label text="Forgot password?" class="card-title motion-item"/>
        <ui:Label text="Enter your email or username and we will send you a code to choose a new password." class="card-subtitle motion-item"/>
        <ui:VisualElement class="input-group motion-item">
            <ui:VisualElement class="field-label-row"><ui:Label text="Email or username" class="field-label"/></ui:VisualElement>
            <ui:TextField name="identifier-field" placeholder="Enter email or username" class="input-field"/>
            <ui:Label name="identifier-error-label" class="field-error" style="display: none;"/>
        </ui:VisualElement>
        <ui:Label name="forgot-error-label" class="form-error" style="display: none;"/>
        <ui:Button name="send-code-button" class="gradient-button motion-item" style="margin-top: 8px;">
            <ui:Label text="Send code" name="send-code-button-label" class="gradient-button-label"/>
            <ui:VisualElement name="send-code-button-spinner" class="button-spinner" style="display: none;"/>
        </ui:Button>
        <ui:Label name="back-link-label" text="&lt;link=&quot;login&quot;&gt;&lt;color=#00D4FF&gt;Back to login&lt;/color&gt;&lt;/link&gt;" enable-rich-text="true" class="rich-text-link motion-item"/>
    </ui:VisualElement>
</ui:UXML>
