<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/LoginScreen.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/ProfileScreens.uss"/>
    <ui:VisualElement name="mydata-root" class="profile-root">
        <ui:VisualElement class="profile-top-bar">
            <ui:Button name="profile-back-button" text="&#8249; Back" class="profile-back-button"/>
            <ui:VisualElement>
                <ui:Label text="Get a copy of my data" class="profile-title"/>
                <ui:Label text="A copy of what we hold about you." class="profile-subtitle motion-item"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="profile-scroll" mode="Vertical">
            <ui:VisualElement class="privacy-card">
                <ui:Label text="What you get" class="privacy-heading motion-item"/>
                <ui:Label text="Your account details, the cars you saved, the enquiries you sent to dealerships (as the dealership holds them), and a record of how you used the app." class="privacy-text motion-item"/>
                <ui:Label text="How to keep it" class="privacy-heading motion-item"/>
                <ui:Label text="Tap Get a copy of my data, then Copy to clipboard, and paste it somewhere safe, such as a note or an email to yourself." class="privacy-text motion-item"/>
                <ui:Label name="mydata-summary-label" class="privacy-text motion-item" style="display: none; margin-top: 12px;"/>
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:VisualElement class="profile-footer motion-item">
            <ui:Label name="mydata-warning-label" class="field-hint" style="display: none; margin-bottom: 6px;"/>
            <ui:Label name="profile-status-label" class="form-success" style="display: none;"/>
            <ui:Label name="profile-error-label" class="form-error" style="display: none;"/>
            <ui:Button name="mydata-copy-button" text="Copy to clipboard" class="profile-action-button" style="display: none;"/>
            <ui:Button name="mydata-get-button" class="gradient-button" style="margin-top: 8px;">
                <ui:Label text="Get a copy of my data" name="mydata-get-button-label" class="gradient-button-label"/>
                <ui:VisualElement name="mydata-get-button-spinner" class="button-spinner" style="display: none;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
