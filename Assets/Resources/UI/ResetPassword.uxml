<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/LoginScreen.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/ProfileScreens.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/AccountCards.uss"/>
    <ui:VisualElement name="reset-password-card" class="login-card" style="flex-wrap: nowrap; justify-content: center;">
        <ui:Label text="Choose a new password" class="card-title motion-item"/>
        <ui:Label name="reset-subtitle-label" text="Enter the code we emailed you and choose a new password." class="card-subtitle motion-item"/>
        <ui:VisualElement class="input-group motion-item">
            <ui:VisualElement class="field-label-row"><ui:Label text="6-digit code" class="field-label"/></ui:VisualElement>
            <ui:TextField name="code-field" placeholder="000000" max-length="6" class="input-field code-field"/>
            <ui:Label name="code-error-label" class="field-error" style="display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement class="input-group motion-item">
            <ui:VisualElement class="field-label-row"><ui:Label text="New password" class="field-label"/></ui:VisualElement>
            <ui:TextField name="new-password-field" placeholder="At least 8 characters" is-password="true" class="input-field"/>
            <ui:Label name="new-password-error-label" class="field-error" style="display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement class="input-group motion-item">
            <ui:VisualElement class="field-label-row"><ui:Label text="Confirm new password" class="field-label"/></ui:VisualElement>
            <ui:TextField name="confirm-password-field" placeholder="Repeat the new password" is-password="true" class="input-field"/>
            <ui:Label name="confirm-password-error-label" class="field-error" style="display: none;"/>
        </ui:VisualElement>
        <ui:Label name="reset-notice-label" class="form-success" style="display: none;"/>
        <ui:Label name="reset-error-label" class="form-error" style="display: none;"/>
        <ui:Button name="reset-button" class="gradient-button motion-item" style="margin-top: 8px;">
            <ui:Label text="Change password" name="reset-button-label" class="gradient-button-label"/>
            <ui:VisualElement name="reset-button-spinner" class="button-spinner" style="display: none;"/>
        </ui:Button>
        <ui:Button name="resend-button" text="Resend code" class="text-link-button motion-item"/>
        <ui:Label name="back-link-label" text="&lt;link=&quot;login&quot;&gt;&lt;color=#00D4FF&gt;Back to login&lt;/color&gt;&lt;/link&gt;" enable-rich-text="true" class="rich-text-link motion-item"/>
    </ui:VisualElement>
</ui:UXML>
