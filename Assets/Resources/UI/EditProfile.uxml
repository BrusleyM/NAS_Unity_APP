<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/LoginScreen.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/ProfileScreens.uss"/>
    <ui:VisualElement name="edit-profile-root" class="profile-root">
        <ui:VisualElement class="profile-top-bar">
            <ui:Button name="profile-back-button" text="&#8249; Back" class="profile-back-button"/>
            <ui:VisualElement>
                <ui:Label text="Edit Profile" class="profile-title"/>
                <ui:Label text="Your details are shared with the dealership you contact." class="profile-subtitle motion-item"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="profile-scroll" mode="Vertical">
            <ui:VisualElement class="input-group motion-item">
                <ui:VisualElement class="field-label-row"><ui:Label text="First name" class="field-label"/></ui:VisualElement>
                <ui:TextField name="first-name-field" placeholder="First name" class="input-field"/>
                <ui:Label name="first-name-error-label" class="field-error" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement class="input-group motion-item">
                <ui:VisualElement class="field-label-row"><ui:Label text="Last name" class="field-label"/></ui:VisualElement>
                <ui:TextField name="last-name-field" placeholder="Last name" class="input-field"/>
                <ui:Label name="last-name-error-label" class="field-error" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement class="input-group motion-item">
                <ui:VisualElement class="field-label-row"><ui:Label text="Cell number" class="field-label"/></ui:VisualElement>
                <ui:TextField name="cell-number-field" placeholder="+27 82 123 4567" class="input-field"/>
                <ui:Label name="cell-number-error-label" class="field-error" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="username-group" class="input-group motion-item">
                <ui:VisualElement class="field-label-row"><ui:Label text="Username" class="field-label"/></ui:VisualElement>
                <ui:TextField name="username-field" class="input-field"/>
                <ui:Label name="username-error-label" class="field-error" style="display: none;"/>
                <ui:Label name="username-hint-label" class="field-hint"/>
            </ui:VisualElement>
            <ui:VisualElement class="input-group motion-item">
                <ui:VisualElement class="field-label-row"><ui:Label text="Email" class="field-label"/></ui:VisualElement>
                <ui:TextField name="email-field" class="input-field input-field--readonly" is-readonly="true"/>
                <ui:Label text="Your email is your sign-in and can't be changed here." class="field-hint"/>
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:VisualElement class="profile-footer motion-item">
            <ui:Label name="profile-status-label" class="form-success" style="display: none;"/>
            <ui:Label name="profile-error-label" class="form-error" style="display: none;"/>
            <ui:Button name="profile-save-button" class="gradient-button" style="margin-top: 8px;">
                <ui:Label text="Save changes" name="profile-save-button-label" class="gradient-button-label"/>
                <ui:VisualElement name="profile-save-button-spinner" class="button-spinner" style="display: none;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
