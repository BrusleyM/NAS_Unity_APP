<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/LoginScreen.uss"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI%20Docs/Styles/ProfileScreens.uss"/>
    <ui:VisualElement name="change-password-root" class="profile-root">
        <ui:VisualElement class="profile-top-bar">
            <ui:Button name="profile-back-button" text="&#8249; Back" class="profile-back-button"/>
            <ui:VisualElement>
                <ui:Label text="Change Password" class="profile-title"/>
                <ui:Label text="Use at least 8 characters." class="profile-subtitle"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView class="profile-scroll" mode="Vertical">
            <ui:VisualElement class="input-group">
                <ui:VisualElement class="field-label-row"><ui:Label text="Current password" class="field-label"/></ui:VisualElement>
                <ui:TextField name="current-password-field" placeholder="Current password" is-password="true" class="input-field"/>
                <ui:Label name="current-password-error-label" class="field-error" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement class="input-group">
                <ui:VisualElement class="field-label-row"><ui:Label text="New password" class="field-label"/></ui:VisualElement>
                <ui:TextField name="new-password-field" placeholder="New password" is-password="true" class="input-field"/>
                <ui:Label name="new-password-error-label" class="field-error" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement class="input-group">
                <ui:VisualElement class="field-label-row"><ui:Label text="Confirm new password" class="field-label"/></ui:VisualElement>
                <ui:TextField name="confirm-password-field" placeholder="Confirm new password" is-password="true" class="input-field"/>
                <ui:Label name="confirm-password-error-label" class="field-error" style="display: none;"/>
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:VisualElement class="profile-footer">
            <ui:Label name="profile-status-label" class="form-success" style="display: none;"/>
            <ui:Label name="profile-error-label" class="form-error" style="display: none;"/>
            <ui:Button name="profile-save-button" class="gradient-button" style="margin-top: 8px;">
                <ui:Label text="Change password" name="profile-save-button-label" class="gradient-button-label"/>
                <ui:VisualElement name="profile-save-button-spinner" class="button-spinner" style="display: none;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
