<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the project's engine-free logic and its NUnit tests with plain `dotnet test`, so CI needs no
    Unity licence. Only files that have NO UnityEngine dependency may be linked here:
    ScreenVisitTracker, AppEnvironment, EnvironmentPolicy, ProfileValidation, AccountRecovery, ModelVariantRules, SessionExpiryPolicy, SessionRefreshPolicy, ModelCacheRules, ModelDiskCache, DealershipBranding, AccentColor, TrimStyles, OptionMatch, CustomizationSelection.
    The same test files also run inside Unity (Test Runner > EditMode); this proves they stay
    engine-free and pass.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <Compile Include="../../Assets/Scripts/Core/ScreenVisitTracker.cs" />
    <Compile Include="../../Assets/Scripts/Core/AppEnvironment.cs" />
    <Compile Include="../../Assets/Scripts/Core/EnvironmentPolicy.cs" />
    <Compile Include="../../Assets/Scripts/Core/ProfileValidation.cs" />
    <Compile Include="../../Assets/Scripts/Core/AccountRecovery.cs" />
    <Compile Include="../../Assets/Scripts/Core/Motion/Easing.cs" />
    <Compile Include="../../Assets/Scripts/Core/ModelVariantRules.cs" />
    <Compile Include="../../Assets/Scripts/Core/Networking/SessionExpiryPolicy.cs" />
    <Compile Include="../../Assets/Scripts/Core/Networking/SessionRefreshPolicy.cs" />
    <Compile Include="../../Assets/Scripts/Core/ZoomGesture.cs" />
    <Compile Include="../../Assets/Scripts/Core/Services/LoanCalculator.cs" />
    <Compile Include="../../Assets/Scripts/Core/Interface/ILoanCalculator.cs" />
    <Compile Include="../../Assets/Scripts/Core/TrimStyles.cs" />
    <Compile Include="../../Assets/Scripts/Core/OptionMatch.cs" />
    <Compile Include="../../Assets/Scripts/Core/CustomizationSelection.cs" />
    <Compile Include="../../Assets/Scripts/Core/ModelCacheRules.cs" />
    <Compile Include="../../Assets/Scripts/Core/ModelDiskCache.cs" />
    <Compile Include="../../Assets/Scripts/Core/DealershipBranding.cs" />
    <Compile Include="../../Assets/Scripts/Core/AccentColor.cs" />
    <Compile Include="../../Assets/Tests/EditMode/ScreenVisitTrackerTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/EnvironmentPolicyTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/ProfileValidationTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/AccountRecoveryTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/EasingTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/ModelVariantRulesTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/SessionExpiryPolicyTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/SessionRefreshPolicyTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/ZoomGestureTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/LoanCalculatorTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/TrimStylesTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/OptionMatchTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/ModelCacheRulesTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/ModelDiskCacheTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/DealershipBrandingTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/AccentColorTests.cs" />
  </ItemGroup>
</Project>
